{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/laila-kz/governed-vector-platform/main/schemas/gvp_VectorEmbeddingDatasetFacet.json",
  "type": "object",
  "properties": {
    "_producer": {
      "type": "string",
      "format": "uri"
    },
    "_schemaURL": {
      "type": "string",
      "format": "uri"
    },
    "_deleted": {
      "type": "boolean"
    },
    "model_name": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "dimension": {
      "type": "integer"
    },
    "distance_metric": {
      "type": "string",
      "enum": [
        "Cosine",
        "Dot",
        "Euclidean"
      ]
    },
    "strategy_name": {
      "type": "string"
    },
    "strategy_version": {
      "type": "string"
    },
    "chunk_size_tokens": {
      "type": "integer"
    },
    "chunk_overlap_tokens": {
      "type": "integer"
    },
    "tokenizer_name": {
      "type": "string"
    }
  },
  "required": [
    "_producer",
    "_schemaURL",
    "model_name",
    "model_version",
    "dimension",
    "strategy_name",
    "strategy_version",
    "chunk_size_tokens"
  ]
}